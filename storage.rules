rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura pública de la carpeta RECURSOS para que las imágenes de la UI carguen siempre
    match /RECURSOS/{allPaths=**} {
      allow read: if true;
    }
    
    // El resto de archivos (fotos de perfil, etc) requieren autenticación
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}