rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Definimos una ruta para los usuarios basada en su UID
    match /users/{userId}/{allPaths=**} {
      // Permite lectura a cualquier usuario autenticado en la red
      allow read: if request.auth != null;
      
      // Permite escritura (subida/borrado) solo si el usuario es dueño de la carpeta
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}