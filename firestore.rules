rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && userExists() && getUserRole() == 'admin';
    }

    function canWrite() {
      return isAuthenticated() && userExists() &&
             getUserRole() in ['admin', 'analista', 'entrenador', 'director', 'gestion'];
    }

    function isOwner(scoutId) {
      return isAuthenticated() && request.auth.uid == scoutId;
    }

    match /players/{playerId} {
      allow list: if isAuthenticated();
      allow get:  if isAuthenticated();
      allow write: if canWrite();
    }

    match /reports/{reportId} {
      allow list:   if isAuthenticated();
      allow get:    if isAuthenticated() && (isAdmin() || isOwner(resource.data.scoutId));
      allow create: if canWrite() && isOwner(request.resource.data.scoutId);
      allow update: if canWrite() && isOwner(request.resource.data.scoutId);
      allow delete: if canWrite() && (isAdmin() || isOwner(resource.data.scoutId));
    }

    match /playerLists/{listId} {
      allow list:   if isAuthenticated();
      allow get:    if isAuthenticated() && (isAdmin() || isOwner(resource.data.scoutId));
      allow create: if canWrite() && isOwner(request.resource.data.scoutId);
      allow update: if canWrite() && isOwner(request.resource.data.scoutId);
      allow delete: if canWrite() && (isAdmin() || isOwner(resource.data.scoutId));
    }

    match /scheduledMatches/{matchId} {
      allow list:   if isAuthenticated();
      allow get:    if isAuthenticated() && (isAdmin() || isOwner(resource.data.scoutId));
      allow create: if canWrite() && isOwner(request.resource.data.scoutId);
      allow update: if canWrite() && isOwner(request.resource.data.scoutId);
      allow delete: if canWrite() && (isAdmin() || isOwner(resource.data.scoutId));
    }

    match /quickNotes/{noteId} {
      allow list:   if isAuthenticated();
      allow get:    if isAuthenticated() && (isAdmin() || isOwner(resource.data.scoutId));
      allow create: if canWrite() && isOwner(request.resource.data.scoutId);
      allow update: if canWrite() && isOwner(request.resource.data.scoutId);
      allow delete: if canWrite() && (isAdmin() || isOwner(resource.data.scoutId));
    }

    match /users/{userId} {
      allow read:  if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}