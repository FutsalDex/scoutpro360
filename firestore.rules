rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura en la colección de jugadores a cualquier usuario autenticado (incluyendo anónimos)
    match /players/{playerId} {
      allow read, write: if request.auth != null;
    }
    
    // Permitir lectura y escritura en la colección de informes a cualquier usuario autenticado
    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    // Por defecto, denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}