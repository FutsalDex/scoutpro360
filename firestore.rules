rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }

    function canRead() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function canWrite() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (getUserData().role in ['admin', 'analista', 'entrenador', 'director', 'gestion']);
    }

    match /players/{playerId} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    
    match /reports/{reportId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid || 
        (resource != null && resource.data.scoutId == request.auth.uid)
      );
      allow write: if canWrite();
    }

    // Reglas que permiten el filtrado por scoutId en la consulta
    match /playerLists/{listId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid || 
        (resource != null && resource.data.scoutId == request.auth.uid)
      );
      allow write: if canWrite() && (
        isAdmin() || request.resource.data.scoutId == request.auth.uid
      );
    }

    match /scheduledMatches/{matchId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid || 
        (resource != null && resource.data.scoutId == request.auth.uid)
      );
      allow write: if canWrite() && (
        isAdmin() || request.resource.data.scoutId == request.auth.uid
      );
    }

    match /quickNotes/{noteId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid || 
        (resource != null && resource.data.scoutId == request.auth.uid)
      );
      allow write: if canWrite() && (
        isAdmin() || request.resource.data.scoutId == request.auth.uid
      );
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
