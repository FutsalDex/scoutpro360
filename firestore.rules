rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para obtener el rol del usuario autenticado
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Comprobación de rol de Administrador
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }

    // Comprobación de acceso de lectura general
    function canRead() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Comprobación de roles con acceso de edición
    function canWrite() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (getUserData().role in ['admin', 'analista', 'entrenador', 'director', 'gestion']);
    }

    // 1. Reglas para jugadores (players)
    match /players/{playerId} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    
    // 2. Reglas para informes (reports)
    match /reports/{reportId} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    // 3. Reglas para listas de jugadores (playerLists)
    match /playerLists/{listId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid ||
        resource.data.scoutId == request.auth.uid
      );
      allow write: if canWrite();
    }

    // 4. Reglas para partidos programados (scheduledMatches)
    match /scheduledMatches/{matchId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid ||
        resource.data.scoutId == request.auth.uid
      );
      allow write: if canWrite();
    }

    // 5. Reglas para notas rápidas (quickNotes)
    match /quickNotes/{noteId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        request.query.scoutId == request.auth.uid ||
        resource.data.scoutId == request.auth.uid
      );
      allow write: if canWrite();
    }

    // 6. Reglas para usuarios (users)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 7. Denegar por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}