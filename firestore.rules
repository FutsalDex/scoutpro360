rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para obtener el rol del usuario autenticado
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Comprobación de rol de Administrador
    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    // Comprobación de roles con acceso de edición (Analista, Entrenador, Director, Gestión)
    function canWrite() {
      return request.auth != null && 
             (getUserRole() in ['admin', 'analista', 'entrenador', 'director', 'gestion']);
    }

    // Comprobación de roles de lectura (Todos los anteriores + Invitado)
    function canRead() {
      return request.auth != null && 
             (getUserRole() in ['admin', 'analista', 'entrenador', 'director', 'gestion', 'invitado']);
    }

    // 1. Reglas para jugadores (players)
    match /players/{playerId} {
      allow read: if canRead();
      allow write: if canWrite();
    }
    
    // 2. Reglas para informes (reports)
    match /reports/{reportId} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    // 3. Reglas para listas de jugadores (playerLists)
    match /playerLists/{listId} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    // 4. Reglas para partidos programados (scheduledMatches)
    match /scheduledMatches/{matchId} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    // 5. Reglas para notas rápidas (quickNotes)
    match /quickNotes/{noteId} {
      allow read: if canRead();
      allow write: if canWrite();
    }

    // 6. Reglas para usuarios (users)
    match /users/{userId} {
      // Un usuario puede leer su propio perfil y los admins todos
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Solo el usuario puede editar su propio perfil (o admin)
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 7. Denegar por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}