{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Perfil profesional de un jugador de fútbol",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "club": { "type": "string" },
        "nationality": { "type": "string" },
        "marketValue": { "type": "string" },
        "currentPIM": { "type": "number" },
        "tacticalRole": { "type": "string" },
        "grade": { "type": "string", "enum": ["A", "B", "C", "D", "F"] },
        "createdAt": { "type": "object" }
      },
      "required": ["name", "tacticalRole", "currentPIM"]
    },
    "ScoutingReport": {
      "title": "ScoutingReport",
      "description": "Informe detallado de observación de un scout",
      "type": "object",
      "properties": {
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "scoutId": { "type": "string" },
        "scoutName": { "type": "string" },
        "pimScore": { "type": "number" },
        "summary": { "type": "string" },
        "ratings": { "type": "object" },
        "notes": { "type": "object" },
        "createdAt": { "type": "object" }
      },
      "required": ["playerId", "playerName", "scoutId", "pimScore"]
    },
    "PlayerList": {
      "title": "PlayerList",
      "description": "Lista personalizada de jugadores (cartera de talento)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "scoutId": { "type": "string" },
        "playerIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "object" }
      },
      "required": ["name", "scoutId"]
    },
    "ScheduledMatch": {
      "title": "ScheduledMatch",
      "description": "Partido programado en la agenda del scout",
      "type": "object",
      "properties": {
        "homeTeam": { "type": "string" },
        "awayTeam": { "type": "string" },
        "category": { "type": "string" },
        "dateTime": { "type": "object" },
        "scoutId": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "in-progress", "completed"] }
      },
      "required": ["homeTeam", "awayTeam", "scoutId"]
    },
    "QuickNote": {
      "title": "QuickNote",
      "description": "Nota rápida o transcripción de voz sin asignar",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "scoutId": { "type": "string" },
        "assignedPlayerId": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "voice"] },
        "createdAt": { "type": "object" }
      },
      "required": ["content", "scoutId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Información extendida del usuario y sus permisos",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "analista", "entrenador", "director", "gestion", "invitado"] },
        "organization": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "nationality": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["básico", "profesional", "enterprise"] },
        "socials": {
          "type": "object",
          "properties": {
            "twitter": { "type": "string" },
            "linkedin": { "type": "string" },
            "instagram": { "type": "string" }
          }
        },
        "createdAt": { "type": "object" }
      },
      "required": ["uid", "role"]
    }
  },
  "auth": {
    "providers": ["password", "google.com", "apple.com", "anonymous"]
  },
  "firestore": {
    "players": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Colección global de jugadores evaluados."
    },
    "reports": {
      "schema": { "$ref": "#/entities/ScoutingReport" },
      "description": "Colección de informes detallados de scouting."
    },
    "playerLists": {
      "schema": { "$ref": "#/entities/PlayerList" },
      "description": "Listas personalizadas de jugadores creadas por scouts."
    },
    "scheduledMatches": {
      "schema": { "$ref": "#/entities/ScheduledMatch" },
      "description": "Agenda de partidos programados para observación."
    },
    "quickNotes": {
      "schema": { "$ref": "#/entities/QuickNote" },
      "description": "Bandeja de entrada de ideas y notas de voz sin asignar."
    },
    "users": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Perfiles de usuario con roles y metadatos."
    }
  }
}
